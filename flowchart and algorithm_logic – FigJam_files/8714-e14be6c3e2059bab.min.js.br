widget.register(Widget)
`,IFRAME:`// This widget will open an Iframe window with buttons to show a toast message and close the window.

const { widget } = figma
const { useEffect, Text } = widget

function Widget() {
  useEffect(() => {
    figma.ui.onmessage = (msg) => {
      if (msg.type === 'showToast') {
        figma.notify('Hello widget')
      }
      if (msg.type === 'close') {
        figma.closePlugin()
      }
    }
  })

  return (
    <Text
      fontSize={24}
      onClick={
        // Use async callbacks or return a promise to keep the Iframe window
        // opened. Resolving the promise, closing the Iframe window, or calling
        // "figma.closePlugin()" will terminate the code.
        () =>
          new Promise((resolve) => {
            figma.showUI(__html__)
          })
      }
    >
      Open IFrame
    </Text>
  )
}

widget.register(Widget)
`},p={IFRAME:`<button id="showToastButton">Say hello</button>
<button id="closeButton">Close</button>

<script>
  const showToastButton = document.getElementById("showToastButton");
  showToastButton.onclick = () => {
    parent.postMessage({ pluginMessage: { type: "showToast" } }, "*");
  };

  const closeButton = document.getElementById("closeButton");
  closeButton.onclick = () => {
    parent.postMessage({ pluginMessage: { type: "close" } }, "*");
  };
</script>`}},983510:(e,t,i)=>{"use strict";i.d(t,{M_:()=>s,Q9:()=>a,Vv:()=>l,kA:()=>o});var n=i(253332),r=i(153035),a=(e=>(e.ORG_DISABLED="ORG_DISABLED",e.TEAM_NOT_PRO="TEAM_NOT_PRO",e.CANNOT_EDIT_FILE="CANNOT_EDIT_FILE",e.ERROR="ERROR",e))(a||{});function s(e){let{editorType:t,org:i,team:r}=e;return!!("whiteboard"===t&&(i&&i.workshop_enabled||!i&&r&&(0,n.w5)(r)))}function o(e){let{editorType:t,org:i,team:r,canEdit:a}=e;if("whiteboard"!==t);else if(i&&!1===i.workshop_enabled)return"ORG_DISABLED";else if(r&&!(0,n.w5)(r))return"TEAM_NOT_PRO";else if(!1===a)return"CANNOT_EDIT_FILE";return"ERROR"}function l(e,t){localStorage.setItem((0,r.K)(e),t),localStorage.setItem((0,r.H)(),t)}},153035:(e,t,i)=>{"use strict";function n(){return"anonymous-name-prefill"}function r(e){return`anonymous-name-${e}`}i.d(t,{H:()=>n,K:()=>r})},38467:(e,t,i)=>{"use strict";i.d(t,{D:()=>c});var n=i(755595),r=i(507848),a=i.n(r),s=i(540698);let o=e=>{if(e instanceof n.z.ZodLazy)return o(e.schema);if(e instanceof n.z.ZodEffects)return o(e.innerType());if(e instanceof n.z.ZodLiteral)return[e.value];if(e instanceof n.z.ZodEnum)return e.options;if(e instanceof n.z.ZodNativeEnum)return Object.keys(e.enum);if(e instanceof n.z.ZodDefault)return o(e._def.innerType);if(e instanceof n.z.ZodUndefined)return[void 0];else if(e instanceof n.z.ZodNull)return[null];else return null},l=new Set([n.kY.ZodNullable,n.kY.ZodOptional]);function d(e){return n.z.preprocess(e=>{if(void 0===e)return null;if(e&&"string"==typeof e){if(""===e&&(0,s.Lg)())throw Error("You are passing an empty string for a sinatra date. Don't do that.");return new Date(e)}return e},e)}function c(e,t){return t?function(e,t){let i={},r=e.shape;Object.keys(r).map(e=>e).forEach(e=>{let s=a()(e),o=r[e]._def.typeName;if(o=l.has(o)?r[e]._def.innerType._def.typeName:o,s!==e&&(!t||t.shape[s])){if(o===n.kY.ZodDate){i[e]=d(r[e]);return}i[e]=n.z.preprocess(e=>void 0===e?null:e,r[e])}});let s=t.merge(n.z.object(i).passthrough());return n.z.preprocess(e=>{le